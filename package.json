{
  "name": "dsh-session-matrix",
  "version": "0.14.3",
  "description": "A multi-agent workspace for DeepSeek Harness: run parallel sessions, visualize agent relationships, monitor context usage, and manage task handoffs.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "multi-agent",
    "multi-session",
    "session-management",
    "parallel-sessions",
    "agent-workspace",
    "context-monitoring",
    "agent-graph",
    "agent-handoff",
    "context-engineering",
    "多智能体工作台",
    "多会话管理"
  ],
  "homepage": "https://github.com/Wanqiu12345/dsh-session-matrix#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wanqiu12345/dsh-session-matrix.git"
  },
  "bugs": {
    "url": "https://github.com/Wanqiu12345/dsh-session-matrix/issues"
  },
  "author": "Wanqiu12345",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/zh.json": "./locale/zh.json",
    "./locale/en.json": "./locale/en.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "README.md",
    "LICENSE",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.2-rc.1+": "compatible"
      }
    }
  },
  "scripts": {
    "test": "node test/host.test.mjs"
  }
}
