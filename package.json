{
  "name": "dsh-session-matrix",
  "version": "0.18.0",
  "description": "A panoramic console for DeepSeek Harness: run multiple native sessions and subagents in parallel, see the agent graph, get compaction warnings, and hand work off before context is lost.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "multi-agent",
    "multi-session",
    "session-management",
    "parallel-sessions",
    "context-monitoring",
    "context-rot",
    "compaction",
    "compaction-count",
    "agent-graph",
    "agent-handoff",
    "handoff-protocol",
    "agent-network",
    "多智能体工作台",
    "多会话管理",
    "会话矩阵",
    "上下文压缩预警",
    "上下文监控"
  ],
  "homepage": "https://github.com/Wanqiu12345/dsh-session-matrix#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wanqiu12345/dsh-session-matrix.git"
  },
  "bugs": {
    "url": "https://github.com/Wanqiu12345/dsh-session-matrix/issues"
  },
  "author": "Wanqiu12345",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/zh.json": "./locale/zh.json",
    "./locale/en.json": "./locale/en.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "README.md",
    "LICENSE",
    "cordis.patch.yml",
    "test/",
    "scripts/"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.2-rc.1+": "compatible"
      }
    }
  },
  "scripts": {
    "test": "node test/host.test.mjs && node test/usage-split.test.mjs && node test/usage-reconcile.test.mjs && node test/risk-matrix.test.mjs && node test/usage-vs-projection.test.mjs && node test/cost-buckets.test.mjs && node test/compose.test.mjs",
    "prepublishOnly": "npm test"
  }
}
